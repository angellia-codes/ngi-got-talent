# Copy to .env.local. Both values are safe to expose in the browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# NOTE: the Admin and Judge PINs are deliberately NOT here. They live in
# private.app_secrets in the database and are checked by the verify_pin RPC,
# so they never reach the client bundle. Set them with:
#   update private.app_secrets set value = '<pin>' where key = 'admin_pin';
